// Supabase Postgres schema for the Atoll OTA.
// Managed with: npm run db:push  (prisma db push)
// RLS policies + auth signup trigger live in scripts/db-init.mjs (raw SQL via Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")    // shared transaction-mode pooler (6543)
  directUrl = env("DIRECT_URL")      // session-mode pooler (5432) for migrations/db push
}

/// Created automatically by the auth signup trigger (scripts/db-init.mjs).
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @default("") @map("full_name")
  /// 'member' | 'admin' — admins can write hotel_content (CMS).
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("profiles")
}

/// Rewards balances; row created by the signup trigger.
model Reward {
  userId            String  @id @map("user_id") @db.Uuid
  islandCash        Decimal @default(0) @map("island_cash") @db.Decimal(12, 2)
  pendingIslandCash Decimal @default(0) @map("pending_island_cash") @db.Decimal(12, 2)
  stamps            Int     @default(0)

  @@map("rewards")
}

model Booking {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique
  userId          String   @map("user_id") @db.Uuid
  resortId        String   @map("resort_id")
  villaId         String   @map("villa_id")
  mealPlan        String   @map("meal_plan")
  /// Live-rate identity (portal slug + display names); null on legacy rows.
  hotelSlug       String?  @map("hotel_slug")
  hotelName       String?  @map("hotel_name")
  roomName        String?  @map("room_name")
  checkIn         DateTime @map("check_in") @db.Date
  checkOut        DateTime @map("check_out") @db.Date
  adults          Int
  children        Int      @default(0)
  rooms           Int      @default(1)
  paymentType     String   @default("pay_at_property") @map("payment_type")
  refundable      Boolean
  traveler        Json
  quote           Json
  status          String   @default("confirmed")
  islandCashUsed  Decimal  @default(0) @map("island_cash_used") @db.Decimal(12, 2)
  islandCashEarned Decimal @default(0) @map("island_cash_earned") @db.Decimal(12, 2)
  stampsEarned    Int      @default(0) @map("stamps_earned")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, checkIn(sort: Desc)], map: "bookings_user_idx")
  @@index([status], map: "bookings_status_idx")
  @@map("bookings")
}

model SavedStay {
  userId     String   @map("user_id") @db.Uuid
  resortSlug String   @map("resort_slug")
  /// Snapshot so Trips can render saved stays without a rates lookup.
  hotelId    String?  @map("hotel_id")
  hotelName  String?  @map("hotel_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([userId, resortSlug])
  @@map("saved_stays")
}

/// Admin-managed hotel content (CMS), mapped to the rates API by hotel_id.
/// Public read; writes restricted to profiles.role = 'admin' via RLS.
model HotelContent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId            String    @unique @map("hotel_id")
  portalSlug         String?   @map("portal_slug")
  name               String
  description        String?   @db.Text
  atoll              String?
  stars              Int?
  photos             String[]  @default([])
  amenities          String[]  @default([])
  website            String?
  lat                Float?
  lng                Float?
  checkInFrom        String?   @map("check_in_from")
  checkInNotes       String?   @map("check_in_notes") @db.Text
  checkOutUntil      String?   @map("check_out_until")
  cancellation       String?   @db.Text
  childPolicies      String?   @db.Text @map("child_policies")
  cotExtraBed        String?   @db.Text @map("cot_extra_bed")
  petsAllowed        Boolean?  @map("pets_allowed")
  petsNotes          String?   @db.Text @map("pets_notes")
  paymentMethods     String[]  @default([]) @map("payment_methods")
  finePrint          String?   @db.Text @map("fine_print")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([hotelId], map: "hotel_content_hotel_idx")
  @@map("hotel_content")
}

/// Guest reviews keyed to the rates API hotel_id. Public read; authenticated
/// users write their own (one per hotel); admins may remove.
model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String   @map("hotel_id")
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  title     String?
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([hotelId, userId], map: "reviews_hotel_user_key")
  @@index([hotelId, createdAt(sort: Desc)], map: "reviews_hotel_idx")
  @@map("reviews")
}
