# Supabase — client-side (safe to expose, anon role + RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server/admin (never expose to the browser, never commit)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Prisma / Postgres — transaction-mode pooler (runtime) + session-mode (migrations)
DATABASE_URL=postgresql://postgres.[project-ref]@[pooler-host]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]@[pooler-host]:5432/postgres
